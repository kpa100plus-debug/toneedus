{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modu-challenge",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modu-challenge-db",
      "database_id": "472f68ee-24da-4d11-b9c8-6a8f2ee597be",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "staging",
    "PLATFORM_FEE_RATE": "0.10",
    "SESSION_TTL_DAYS": "30",
    "OWNER_DEFAULT_BOUNTY_LIMIT": "1000000",
    "PRIMARY_ADMIN_EMAIL": "kpa100plus@gmail.com",
    "PUBLIC_MONEY_ENABLED": "false",
    "TERMS_VERSION": "2026-08-29-v1",
    "PRIVACY_VERSION": "2026-08-31-v2"
  }
}
